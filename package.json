{
	"name": "obsidian-recording-importer-core",
	"version": "0.2.0",
	"description": "Shared TypeScript source for the recording-importer Obsidian plugins: the recording model, note writer, import runner, vault index and auto-sync.",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"sideEffects": false,
	"scripts": {
		"lint": "eslint . --max-warnings 0 && prettier --check \"**/*.ts\" && node scripts/check-submission.mjs && npm run typecheck:marketplace",
		"typecheck:marketplace": "tsc --noEmit -p tsconfig.scan.json",
		"test": "vitest run",
		"knip": "knip",
		"type-coverage": "type-coverage",
		"hooks": "node .husky/install.mjs"
	},
	"typeCoverage": {
		"atLeast": 99
	},
	"keywords": [
		"obsidian"
	],
	"author": "Charles Kelsoe (ckelsoe)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ckelsoe/obsidian-recording-importer-core.git"
	},
	"peerDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"obsidian": "^1.13.0"
	},
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.2",
		"@types/node": "^24.0.7",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"eslint-plugin-sonarjs": "^4.2.1",
		"globals": "^17.1.0",
		"husky": "^9.1.7",
		"knip": "^6.38.0",
		"moment": "^2.31.0",
		"obsidian": "^1.14.4",
		"prettier": "^3.9.6",
		"tslib": "^2.8.1",
		"type-coverage": "^2.30.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"@humanfs/node": "^0.16.8",
		"brace-expansion@1": "^1.1.21",
		"brace-expansion@2": "^2.1.7",
		"brace-expansion@5": "^5.0.12",
		"browserslist": "^4.28.7",
		"fast-uri": "^3.1.9",
		"glob": "^14.0.3",
		"handlebars": "^4.7.10",
		"js-yaml": "^4.3.2",
		"moment": "^2.31.0",
		"qs": "^6.16.1",
		"test-exclude": "^8.0.0",
		"zod": "^4.6.6",
		"minimatch@9": "^11.0.8",
		"minimatch@10": "^11.0.8",
		"type-coverage-core": {
			"minimatch": "^11.0.8"
		}
	}
}
